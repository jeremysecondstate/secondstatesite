if(typeof $==='undefined'){$={};}
if(typeof $.HA==='undefined'){$.HA={};}
$.HA.BatchBid=(function(){var that={};that.form=null;that.inputs=null;that.confirmButton=null;that.needToConfirm=true;that.isConfirmed=false;that.pricesWithBP={};that.validated={};that.saleNos=[];that.countdownsLoaded=0;that.setErrors=function(val){that.errors=val;return that;};that.hasErrors=function(){return that.errors;};that.setIsValidated=function(index,val){if(val){that.validated[index]=true;}else{delete(that.validated[index]);}
return that;};that.isValidated=function(index){return typeof that.validated[index]!='undefined';};that.hasBidsEntered=function(){that.saleNos=[];that.inputs.forEach(function(el){var saleNo=el.dataset.saleNo;var isBid=el.value!=='';if(isBid&&that.saleNos.indexOf(saleNo)<0){that.saleNos.push(saleNo);}});return that.saleNos.length>0;};that.validate=function(input){var index=that.getIndexOfInput(input);if(!that.isValidated(index)){that.setIsValidated(index,true);var bid=input.value.trim();var min=parseFloat(input.nextElementSibling.value);if(bid!==''){if(/^[0-9]+$/.test(bid)&&bid<min){var formatter=new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0});throw('The bid you entered is lower than the minimum bid!<br>Please enter a dollar value of at least the minimum bid of '+formatter.format(min));}else if((bid.toString().length!==parseInt(bid).toString().length)||bid<=0||bid>999999999){throw('Your bid must be a whole dollar amount.<br />Do not include the dollar sign ($) or decimal points.');}}}
return that;};that.getCurrentItemInfo=function(lot){fetch('/c/webservices/vue/get-item-info.zx?'+new URLSearchParams({saleNo:lot.saleNo,lotNo:lot.lotNo,infoType:'all',halive:lot.hasHeritageLive,sessionNo:lot.sessionNo}),{method:'GET',headers:{'Content-Type':'application/json'},cache:'no-cache'}).then(function(response){return response.json();}).then(function(data){var row=document.getElementById(lot.saleNo+"-"+lot.lotIdNo);if(row){var displayBidControls=row.querySelector('.display-bid');if(displayBidControls){displayBidControls.innerHTML=data.currentBid;}
var displayBidControlsWithBP=row.querySelector('.display-bid-with-bp');if(displayBidControlsWithBP){displayBidControlsWithBP.innerHTML='('+data.currentBidBP+')';}
var displayNextBid=row.querySelector('.display-next-bid');if(displayNextBid){displayNextBid.innerHTML='$'+data.nextBid;row.querySelector(".display-next-bid-with-bp").innerHTML='($'+data.nextBidBP+')';}
if(data.isLoggedIn){if(data.highestPossibleBidClean>0||!data.liveProxyHidden){if(data.maxBidClean==0){data.maxBid=data.liveProxyBid;data.maxBidBP=data.liveProxyBidBP;data.maxBidClean=data.liveProxyBidClean;}
var maxBid=row.querySelector(".display-maxbid");if(maxBid){maxBid.innerHTML='<strong>'+data.maxBid+'</strong>';maxBid.classList.remove('winning-bid','losing-bid');maxBid.classList.add(data.isHighBidder||data.maxBidClean>data.currentBidClean?'winning-bid':'losing-bid');maxBid.classList.toggle('one-increment',data.isHighBidder&&data.maxBidClean<=data.nextBidClean);row.querySelector(".display-maxbid-with-bp").innerHTML='('+data.maxBidBP+')';}
var highestBid=row.querySelector(".display-highestbid");if(highestBid){highestBid.innerHTML='<strong>'+data.highestPossibleBid+'</strong>';highestBid.classList.remove('winning-bid','losing-bid');highestBid.classList.add(data.isHighBidder||data.highestPossibleBidClean>data.currentBidClean?'winning-bid':'losing-bid');row.querySelector(".display-highestbid-with-bp").innerHTML='('+data.highestPossibleBidBP+')';}
var liveproxyBid=row.querySelector(".display-liveproxybid");if(liveproxyBid){liveproxyBid.innerHTML=data.liveProxyBid;}
var bidProtectControls=row.querySelector('.bid-protect-controls');if(bidProtectControls){bidProtectControls.value=data.bidProtection?data.bidProtection:'';}}}
var timeLeft=row.querySelector('.time-left');if(timeLeft&&!data.biddingEnded){window.EventManager.fire('batch-bid-countdown-reset',{saleNo:lot.saleNo,lotNo:lot.lotNo,endTime:data.biddingEndTime,serverTime:data.serverTime});if(data.isInExtendedBidding){var forText=row.querySelector('.for-text');if(forText){forText.innerHTML=data.forText;}
var timeLeftLabel=row.querySelector('.time-left-label');if(timeLeftLabel){timeLeftLabel.innerHTML=data.timeLeftLabel+'<br>';timeLeftLabel.classList.remove('hidden');}}}else{var timeLeftLabel=row.querySelector('.time-left-label');if(timeLeftLabel){timeLeftLabel.classList.add('hidden');}}
var bulkBidNextAmount=document.getElementById("bulkBidNextAmount_Sale_"+lot.saleNo+"_Lot_"+lot.lotNo);if(bulkBidNextAmount){bulkBidNextAmount.value=data.nextBidClean;}}})};that.updatePreview=function(input){var bid=input.value.trim();var saleNo=input.getAttribute('data-sale-no');var lotNo=input.getAttribute('data-lot-no');var bidProtectNumIncrementsElm=document.getElementById(`bidProtectNumIncrements_Sale_${saleNo}_Lot_${lotNo}`);var bidProtectNumIncrements=0;if(bidProtectNumIncrementsElm){bidProtectNumIncrements=bidProtectNumIncrementsElm.value;}
if(bid!==''){window.EventManager.fire('batch-bid:update-bid',{amount:bid,saleNo:saleNo,lotNo:lotNo,bidProtectNumIncrements:bidProtectNumIncrements});}
else{window.EventManager.fire('batch-bid:remove-bid',{saleNo:saleNo,lotNo:lotNo});}
if(!that.hasBidsEntered()){that.reset();}
return that;};that.getIndexOfInput=function(input){var i=0;that.inputs.forEach(function(element,index){if(element==input){i=index;return;}});return i;};that.showError=function(error,input){window.Dialogs.getAlert({html:true}).setTitle('Error').setBody(error).onHide(function(){if(typeof input!='undefined'){input.value='';input.focus();if(!that.hasBidsEntered()){that.reset();}else{var haDialog=document.querySelectorAll('.ha-dialog');if(haDialog&&haDialog.length==1){that.setErrors(false);}
that.setIsValidated(that.getIndexOfInput(input),false).updatePreview(input);}}}).show();return that;};that.reset=function(){that.inputs.forEach(function(input){input.value='';});that.isConfirmed=false;that.validated={};if(that.confirmButton){that.confirmButton.value='Submit Bid(s)';that.confirmButton.disabled=false;}
if(window.EventManager){window.EventManager.fire('batch-bid:reset');}
return that.setErrors(false);};that.track=function(){var items=[];var inputs=document.querySelectorAll('input.bid-input');inputs.forEach(function(input){if(input.value){items.push({id:input.getAttribute('data-sale-no')+'-'+input.getAttribute('data-lot-id-no'),price:1,quantity:1});}});window.Criteo.set('items',items);};that.init=function(){that.form=document.getElementById('batchBids');that.inputs=document.querySelectorAll('input.bid-input');that.confirmButton=document.querySelector('input[type="submit"][id="confirm-bids"]');that.bidProtectControls=document.querySelectorAll('.bid-protect-controls');that.reset();window.EventManager.listen('batch-bid:cancel',()=>{that.needToConfirm=false;that.reset();});window.EventManager.listen('batch-bid:submit',()=>{if(!that.hasErrors()&&that.isConfirmed){that.needToConfirm=false;that.form.submit();}});window.EventManager.listen('batch-bid-countdown-ended',(lot)=>{that.getCurrentItemInfo({saleNo:lot.saleNo,lotNo:lot.lotNo,lotIdNo:lot.lotIdNo,infoType:'all',hasHeritageLive:lot.hasHeritageLive,sessionNo:lot.sessionNo});});window.EventManager.listen('batch-bid-protection-update',(bidData)=>{bidData.infoType='all';bidData.hasHeritageLive=1;that.getCurrentItemInfo(bidData);});window.onbeforeunload=function(){if(that.hasBidsEntered()&&that.needToConfirm){return'Your bid(s) has NOT been submitted!';}};that.form&&that.form.addEventListener('submit',function(e){e.preventDefault();that.track();if(!that.hasBidsEntered()){that.showError('You must enter at least one bid.');return false;}
if(!that.hasErrors()){if(!that.isConfirmed){that.isConfirmed=true;if(that.confirmButton){that.confirmButton.value='Confirm Below';that.confirmButton.disabled=true;that.confirmButton.scrollIntoView({behavior:'smooth',block:'center'});window.EventManager.fire('batch-bid:submitted');}}}});that.inputs.forEach(function(input){input.addEventListener('change',function(){try{that.setIsValidated(that.getIndexOfInput(input),false).validate(this).updatePreview(this);}catch(error){that.setErrors(true).showError(error,this);}});});window.EventManager.fire('batch-bid-countdowns-init');window.EventManager.listen('batch-bid-countdown-loaded',()=>{that.countdownsLoaded++;if(that.countdownsLoaded>=document.querySelectorAll('tbody .time-left').length){window.EventManager.fire('batch-bid-countdowns-init');}});};return that;})();$.HA.BatchBid.OutbidNotice=(function(){var that={};that.show=function(){if(!that.disabled){that.disabled=true;var dialog=window.Dialogs.getAlert({'customClass':'outbid',html:true}).onShow(function(){var disableButtons=document.querySelectorAll('input.disable');disableButtons.forEach(function(element){element.addEventListener('change',function(){if(this.checked){dialog.disable();}});});});dialog.load('outbid',{}).then(function(response){dialog.setBody(response.data.body).show();});}
return that;};that.init=function(){that.disabled=window.location.href.indexOf('/batch-bid.zx')==-1;};that.init();return that;})();
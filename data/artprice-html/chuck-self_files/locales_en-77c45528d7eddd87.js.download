lease %a%consult the FAQ%/a%.",m4:"The Artprice Team",m5:"Close"},conversation:{m1:"Conversation Thread"},message:{m3:"Delete",m2:"Reply",m1:"Back",m4:"From",m5:"Artprice Customer Service",m6:"Subject",m7:"Me"}},stripe:{customer:{protal:{button:{m1:"Manage my subscription"}}}},login:{m1:"Welcome",m2:"To continue, log into your account.",m3:"Log in",m4:"Sign-up",m5:"Forgot your password?",m7:"Log in",m10:"Username",m11:"Password",m15:"The username is required.",m16:"The password is required."},emailvalidationneeded:{contents:{noemail:{m1:"Let's stay in touch!",m2:"You haven't added your email address to your Artprice account yet.",m3:"Please add your email address so that we can send you updates and essential information about your Artprice account and subscription, such as help with password recovery.",m4:"Rest assured, this will not change your mailing preferences. You will only receive the communications to which you have subscribed.",m5:"Add my email address",m6:"Need help?",m7:"Contact Customer Care"}}},signinconfirmation:{m1:"Your registration is confirmed",m2:"Your Artprice account has been successfully created!",m3:"To finalize your registration, go to your email inbox to <strong>confirm your email address</strong>.",m4:"If you do not receive a message from us, remember to check your Spam.",m5:"Continue browsing",freedemo:{m1:"Get notified about your artists",m2:"Select your favorite artists and receive our alerts as soon as a work is available at auction or on the Artprice Marketplace.",m3:"Start searching"},marketplace:{m1:"Expand your collection",m2:"Find your next acquisition amid more than 70,000 works for sale on the Marketplace.",m3:"See the Marketplace Listings",m4:"Sell ​​your works with Artprice",m5:"Post 3 Marketplace Listings for free to our international audience.",m6:"How to sell"},report:{m1:"Consult our Art Market reports",m2:"Artprice with ArtMarket® Insight, Artprice's press agency, publishes exclusive reports on the Art Market several times a year.",m3:"Read the latest report"}}},customerlotslist:{error:{m1:"An error occured"}},tour:{accountlang:{section:{title1:"Display Language Preference",content1:"To choose the language you prefer to <b>receive Artprice correspondence</b>, go to your customer area to <b>change your correspondence language</b>.",button1:"View/Change Correspondence Language"}},emailvalidationneeded:{contents:{locked:{m1:"Confirm your email address",m2:"Artprice complies with the changes in data protection regulations. That is why we ask you to confirm your email address",m3:"It's easy as 1-2-3",m4:"Click the button below",m5:"Check your email inbox",m6:"If you do not receive a message from us, check your Spam folder.",m7:"Click the link received to finalize the verification procedure!",m8:"As soon as you have confirmed your email, you can get back to your search and enjoy all your subscription benefits!",m9:"Need help?",m10:"Contact Customer Care",m11:"Thank you for your understanding.",m12:"You no longer have access to this email or you want to add another one? %a%Update your email here%/a%."}},section:{title1:"Please confirm your email address."}}},customer:{top_menu:{m1:"My subscription",m3:"Seller profile",m4:"My personal details"},_top_menu_level_1:{m2:"My invoices"},_left_menu:{m2:"My mailbox"}},ails:{landingpage:{records:{record:{m1:"Exceptional result"},m2:"Browse the lots that have stood out in our sales"},m1:"Currently at %name%",consignment:{m4:"Consign with us!",m5:"Contact the auction house"},header:{terms:{m1:"Read more",m2:"Hide"},contact:{m1:"Address",m2:"Contact"}},sales:{sale:{lot:{m1:"Estimate"},m3:"Highlight Sale",m4:"See the entire sale"},m2:"Explore our Auction Highlights"},lots:{lot:{m1:"Estimate",m2:"Lot Highlight"},m2:"Don't miss our must-have lots"},agenda:{m4:"Don't miss our future auctions",m2:"Show all auctions",m3:"from %dtstart% to %dtend%"}},info:{m1:"Advertise with Artprice!",m3:"Discover our new customized advertising spaces",m4:"Homepage",m5:"daily views",m6:"5.5M",m7:"monthly views",m8:"Inline rectangle",m9:"Billboard",m10:"Sponsored Homepage",m11:"Artist pages",m12:"direct entries",m13:"Leaderboard",m14:"NEWSLETTER",m15:"Subscribers",m16:"Banners",m17:"Marketplace",m18:"Sponsored Newsletter",m19:"Banners",m20:"Social media",m21:"6.3M",m23:"42K",m25:"Press release",m26:"700M",m27:"Readers",m28:"News feed",m29:"Articles",m30:"page viewed/month",m31:"Advertorial",m32:"Sponsored Articles",m33:"Interested or want to know more?",m34:"Request our Media Kit",m35:"Advertising spaces for Auction Houses",m38:"Auction Highlights",m41:"Featured Lots",m44:"Auction House Page",m45:"Request our Media Kit",m46:"Get a head start",m47:"Aim for the heart of the artist market",m48:"Showcase your auctions and your news.",m49:"Your Auction Highlights",m50:"Your Lot Highlights",m51:"Your Landing Page",m52:"Meet the team",m53:"Our team is always ready to help you design your advertising campaigns to ensure greater visibility for your sales, exhibitions, auction records, consignments and any other news.",m54:"Place your advertising campaigns where art enthusiasts and art professionals converge to buy, sell and appraise works",m55:"Target a qualified audience of art collectors and art professionals",m56:"Your advertisements integrated into Art Market News with Artprice’s Intuitive Artmarket® AI",m57:"Get exactly the right exposure for your sales, exhibitions, auction records, consignments and art market news.",m58:"Target potential buyers and bidders as well as consignors.",m59:"Raise market awareness of your brand.",m60:"We use Artprice because we know that our sales will benefit from a significant audience on this platform, particularly for fine art. We are very satisfied with our customer experience: you listen to our needs and do not hesitate to make suggestions to optimize our advertising strategy for each sale, which demonstrates real support from your team.",m61:"Artprice provides us as an auction house with the perfect platform to present our artworks to a wide range of buyers. The advertising always fulfils our high standards. The team always processes our inquiries in the shortest possible time and ensures the perfect presentation of our auction catalogue on the website. We are therefore more than satisfied with our long-standing collaboration.",m62:"They trust us",m63:"Artprice provides a wonderful platform for Pundole’s to advertise our upcoming auctions.  They have a variety of banners and images that work well in different spots, depending on which part of the website one is browsing.",m65:"I have been advertising with Artprice for more than 5 years. Their advertising program provides us with consistent positive results, with bidders from all over the world alerted to artists at auction, whose works we are selling. I can’t think of any other third-party provider with such a wide reach. My staff and I also enjoy working with the artprice team, who are very responsive and helpful and have always gone the extra mile to get our information out to the world in a timely manner.",m66:"Artprice is a reliable platform which offers the latest sold price and market status. We have been doing the campaign on it for exposing the highlight art pieces in the global market. Also the team is very efficient and supportive.",m67:"We have also been a long-time user of their advertising services, and regularly receive bidding leads as a result of our ads. Everyone we've worked with there is helpful and friendly; our rep Svetlana provides proactive reporting and personalized assistance. I was particularly impressed by her kind reminder about a law that differs in our countries affecting one of our ad selections...it is easy to overlook in a busy time at an auction house, but her reminder saved time and back-and-forth over a minor note - much appreciated! Over our ten+ years using Artprice's services, we have been continually impressed across the board.",m68:"Always one of the most reliable sources of information on the international art market. An essential tool for auction houses, galleries and collectors around the world.",m69:"We have used Artprice to promote our auctions for several years and think it's one of the most useful sites in the industry. As soon as our catalog is published on Artprice, we receive numerous visits from potential clients all over the world.",m70:"Berlin, Germany",m71:"Mumbai, India",m72:"Mamaroneck, NY, USA",m73:"Taipei, Taiwan",m74:"Lake Worth Beach, FL, USA",m75:"Milan, Italy",m76:"Brescia, Italy",m77:"Paris, France",m78:"Request a call back",m79:"Thanks to our promotional campaign on Artprice, we achieved a record sale with a work by Keith Haring, far exceeding the results achieved by other auction houses. We also attracted new clients who, without Artprice, would never have had access to our catalog. We won’t hesitate to do it again, even for modest works!",m80:"Belgium"},landingpagelinkforauctioneer:{m1:"View Auction House"}},message:{index:{m4:"Customer Care",m2:"Marketplace",m1:"Messages"}},layout:{footer:{m1:"General Conditions of Sale & Use",m2:"Confidentiality and personal data protection charter",m3:"Withdrawal process",m4:"Your rights and obligations as a user of our Marketplace",m5:"Manage cookie settings",m6:"FAQ",m7:"Pricing",m8:"Auction House Partner program",m9:"Advertising",m10:"Careers",m11:"Artist index",m12:"Visit the Artprice headquarters",m13:"Press Releases",m14:"INTERPOL's database on Stolen Works of Art",m15:"Artmarket.com is listed on Eurolist by Euronext Paris (Euroclear : 7478 - Bloomberg : PRC - Reuters : ARTF) - Artprice is a department of ArtMarket.com",m16:"&copy; Thierry Ehrmann 1987-%current_year% All rights reserved",m17:"Artmarket.com, BP 69 - Domaine de la Source 69270 Saint Romain au Mont d'Or – France",m18:"About us",m19:"Artprice by Artmarket is headquartered at the Organe Museum of Contemporary Art, which manages The Abode of Chaos.",m20:"Accessibility Statement",m21:"Artprice.com, partner of the Lyon Biennial of Contemporary Art",m22:"Our editorial policy"},header:{promotion:{notify:{m1:"Discover our offer"}},safari:{notify:{m1:"An update to your Safari browser is required. Within 1 month, this version will no longer be supported, and we will no longer be able to guarantee proper functioning and secure browsing on Artprice. If you're already using the latest version compatible with your operating system, you can install another browser (Google Chrome, Firefox, etc.)."}}},notify:{news:{m1:"New feature: Artprice News!",m2:"Discover highlights from the global Art Market every day.",m3:"Explore Artprice News"}},warnings:{multiuser:{m1:"Contact us",m2:"Close",m3:"Log in again",m4:"Upgrade my subscription",m5:"Important"}}},application:{secure_multiuser:{p1:"You have been disconnected because an additional active session has been detected (from IP address %ip% on %os%).",p2:"To continue browsing our site, please make sure only one session is active at a time.",p3:"If you do not recognise the additional session, we recommend that you %a%reset your password%/a% immediately.",child_account:{p1:"Please contact your account administrator for any changes."},upgrade:{p1:"If needed, you can add a new user to your %curabo% for just %upgradeprice%!"},no_upgrade:{p1:"If needed, contact us to add a new user to your subscription."}}},artmarketinsight:{reports:{m9:"Nota bene",m10:"Access our art market reports",m11:"To view our latest report, you must log in or create a free account. Enjoy many benefits, including access to our most recent reports.",m12:"Sign Up for free",m15:"Login",m16:"A final step to download our free report. Go to your mailbox to confirm your email address (remember to check your spam folder).",m17:"Send a new validation email",m13:"Access is reserved for members<br> Please <strong>log in or create a free account</strong> to view information."},report:{m1:"Table of contents"}},reports:{report:{pdfbutton:{m1:"Download the report"}}},legals:{m1:"Close",m2:"YOUR RIGHTS AND OBLIGATIONS AS A USER OF THE MARKETPLACE",m3:"Print"},payments:{common:{availlablepaymennts:{m1:"100% secure payment",m3:"You can also choose to pay by bank transfer or by telephone."},cartsummary:{m1:"%nb% users",m2:"1 user",m3:"+ %nbdays% free days",m4:"1 day free",m5:"Subscription valid from %dtstart% to %dtend%",m6:"Subscription valid until %dt%",m7:"Need help with your order?",m8:"Contact our customer service",m9:"Automatic renewal every 30 days",m10:"Non-binding",m11:"Your benefits",m12:"Your benefits",m13:"1 day",m14:"1 month",m15:"1 year",m16:"2 years",promocode:{m1:"OK",m2:"Promotion code does not apply",m3:"This promotion code does not exist",m4:"This promotion code is no longer valid.",m5:"promo not_started_yet",m6:"You have already used this promotion code",m7:"Promotion code"},m17:"Your order"}},layout:{navigation:{m2:"Information",m3:"Payment",m4:"Activation"}},ok:{links:{m1:"See my Artpricing reports",m2:"Back to previous search",m3:"Back to the Marketplace",m4:"Back to my account"},m1:"Order confirmation",m2:"Your order n°%idphysicsale% has been successfully validated and confirmed to you by email.",m3:"Your order #%idphysicsale% was successfully submitted. We will send you a confirmation email upon receipt of your payment.",m4:"Customize your Artprice Store <a href='%url%'>here</a>.",m5:"To secure your account, you must <b>confirm your email address</b>, %a%log in%/a% and follow the verification procedure.",m6:"To secure your account, <b>go to your email inbox to confirm your email address!</b>",m7:"To secure your account, please <b>confirm your email address</b> by clicking the button below. Then go to your email inbox and <b>click the link received</b> to finalize the verification procedure!",m8:"If you do not receive a message from us, remember to check your Spam.",m9:"If you do not receive a message from us, remember to check your Spam.",m10:"Order Pending",m11:"Please wait...",m12:"Your order is being processed.",m13:"A problem has occurred",m14:"There was a problem processing your order, please get in touch with us."},platforms:{offline:{m1:"You can pay for your subscription by Visa, Mastercard or American Express. A confirmation will be sent to you by email as soon as your order has been processed.",m2:"Validation of your order upon receipt of payment. A confirmation will be sent to you by email.",m3:"Print the order form",m4:"Our Customer Service is available from Monday to Thursday between 8.00 AM and 7.00 PM GMT/UTC and on Friday between 8.00 AM and 6.00 PM GMT/UTC.",m5:"France: 04 72 42 17 06",m6:"United States –toll free– 866-732-0826",m7:"Canada –toll free– 866-732-8383",m8:"Toll free for other selected countries: 800-2780-0000 (preceded by 00 for an international call)",m9:"Australia, Austria, Belgium, Denmark, Finland, Germany, Hong kong, Ireland, Israel, Italy, Japan, Netherlands, New zealand, Norway, Spain, Sweden, Switzerland, Thailand, United kingdom",m10:"For other countries and France: +33 472 421 706"},stripe:{checkoutform:{m1:"Choose Klarna to buy now and pay later or split your payment over time (payment options depend on your country).",m2:"Pay Now"},m1:"The order is activated upon receipt of payment"},paypal:{m1:"Your order will be validated as soon as PayPal has collected the payment. A confirmation will be sent to you by email."},m1:"Secure online payment",m2:"Paypal",m3:"Payment by wire transfer",m4:"Pay by phone",m5:"Select your payment method",m6:"A problem has occurred"},informations:{form:{cgv:{m1:"⚠ You must read and accept the Terms and Conditions of Use and Sale.",m2:"⚠ You must read and accept the terms of sale and payment of your monthly subscription.",m3:"I understand that this subscription will be automatically renewed every 30 days and that there is no minimum subscription period.",m4:"I have read and accept the %link1%, as well as ARTPRICE.COM’s %link2% and the %link3%.",m5:"Specific Conditions of Sale & Use",m6:"General Conditions of Sale & Use",m7:"Confidentiality and Personal Data Protection Charter",m8:"I authorize Artprice to send me the advantages of my registration and weekly news on the art market (you can choose to unsubscribe anytime)."},password:{m1:"The password must be between 8 and 30 characters long, and contain a lowercase letter, an uppercase letter and a number.",m2:"Your password",m3:"I already have an account",m4:"Log in",m5:"To continue, log into your account.",m6:"Set up a strong password which contains at least",m7:"A lowercase letter",m8:"An uppercase letter",m9:"A number",m10:"Between 8 and 30 characters"},fields:{m1:"Billing address",m2:"Delivery address",m3:"Required information",m4:"First name",m5:"Lastname",m6:"Company",m7:"Street Address",m8:"Zip code",m9:"City",m10:"Country",m11:" State: / County",m12:"Additional information",m13:"⚠ You cannot modify the grayed fields because your seller form has already been validated. Please contact <a href='mailto:marketplace@artprice.com'>marketplace@artprice.com</a> to complete a new form with your updated information",phone:{m1:"Phone number"},tvaintra:{m1:"If you do not have a valid VAT number for your intra-Community transactions, please tick the box below.",m2:"VAT number must be in %format% format",m3:"VAT Number for EEC members only (Example: %sample%)",m4:"I do not have a valid VAT number for my intra-Community operations"}},m1:"Login details",m2:"Email",m3:"Required information",m4:"First name",m5:"Lastname",m6:"Occupation",m7:"Proceed to payment",m8:"Contact details",m9:"Up to %nb% characters"},m1:"Create your account",m2:"Billing information"},proforma:{m1:"The payment link for this order has expired.",m2:"The payment link for this order is invalid.",m3:"This order cannot be processed online."},cartsummary:{validatebutton:{m1:"I have read and accept the %link1%, as well as ARTPRICE.COM’s %link2% and the %link3%.",m2:"Specific Conditions of Sale & Use",m3:"General Conditions of Sale & Use",m4:"Confidentiality and Personal Data Protection Charter"},address:{form:{tvaintra:{m1:"VAT Number (EEC member)"}}}}},estimates:{info:{m1:"Artpricing, price estimate reports by Artprice",m2:"Fill out the form online and receive an estimate report produced by our specialists within 3 days",m3:"Three business days - average delay for a report to be made available, non-binding",m4:"%nb% Artpricing units available on your account",m5:"1 Artpricing unit available on your account",m6:"You have %nb% completed reports ready to be ordered",m7:"Order your reports",m8:"You have 1 completed report ready to be ordered",m9:"Order the report",m10:"You have 1 report pending completion",m11:"You have %nb% reports pending completion",m12:"Access the report",m13:"Access your reports",m14:"Submit an artwork",m15:"Quantity",m16:"Price",m17:"Price per report",m18:"Add to cart",m19:"Log in to continue your order.",m20:"To proceed with your order, you must log in or create an account.",m21:"FAQ",m22:"What information is included in an Artpricing report?",m23:"An Artpricing report is available in PDF version and includes the following:",m24:"an estimated range of the work's current value",m25:"the detailed auction results for at least two comparable artworks",m26:"and, provided there is sufficient information:",m27:"Geographic distribution of auction turnover and distribution by price range (for the technique and artist)",m28:"up to 4 auction results for comparable artworks",m29:"See an example of Artpricing report",m30:"Estimate or appraisal?",m31:"The Artpricing service is an estimate service, not an appraisal. It is issued on the basis that the submitted artwork is authentic, in good condition and of flawless provenance.<br /> An estimate has no legal force and serves for information purposes only.",m32:"Why estimate an artwork?",m33:"So that you can determine an artwork's potential value on the second market and make informed decisions when it comes to buying and selling at the best price.",m34:"To determine the  insurance value",m35:"With Artpricing and the 'Submit for estimate again' option, you can easily keep track of how the value of one or several pieces of your collection changes over time. It only takes a clic for your artwork to be submitted again to our team of specialists - no need to enter again the artwork specifiactions and description (the 'Submit for estimate again' option is available for each of your reports - under 'My account' in 'My Arpricings').",m36:"Can Artprice provide an estimate for all artworks?",m37:"Artprice undertakes to provide a relevant and reliable estimate report, provided that there are enough recent auction results for comparable artworks. If not, we will credit your account with an Artpricing unit -to be used at your convenience with no time limit-, or we will refund you.",m38:"How to submit your artwork(s)?",m39:"The artworks to be estimated must be submitted one by one, online using the Artpricing request form. Email exchanges should focus on subsidiary issues or requests for quotations.",m40:"Please click <a href='%url%'>here</a> to submit your subsidiary questions and requests for quotations.",m41:"Read more",purchasenotavailable:{m1:"Reminder",m2:"You are connected with a satellite account, orders can be processed by the main account's administrator only.",m3:"Back"}}},landingpages:{newsletter:{m1:"Keep pace with the Art Market",m2:"<b>Create an account</b>: get weekly Art Market updates in your inbox, and receive alerts about your favorite artists.",m3:"Sign up for free",m4:"Tracking the market’s rhythm and the auction’s surges",m5:"Our art market specialists analyze the trends in our databases and send you objective insights to follow and understand the market. With a free account, you unlock access to all our articles and News, as well as our archives.",m6:"Receive alerts on your favorite artists",m7:"Never miss an opportunity to sell or buy again.",m8:"Click on the heart next to the artist's name on their page to add them to your favorites.",m9:"What are the advantages of email alerts?",m10:"Create a list of favorite artists.",m11:"Receive an alert when a work by one of your artists is for sale.",m12:"Monitor the market performance of your favorite artists.",m13:"Sign up for free"}},news:{show:{m2:"Please confirm your email address to read more",m3:"The rest of the article is for members only.",m4:"This week's top stories",drawers:{common:{advantages:{m1:"With your Artprice account:",m2:"Track your favorite artists at auction and on the Marketplace",m3:"Set up your alerts and stay on top of the Market",m4:"Enjoy unlimited access to daily Art Market news",m5:"Analyze market trends through our exclusive Reports and Top 500 Artist rankings"}}},also:{m1:"YOU MIGHT ALSO LIKE"},artists:{m1:"EXPLORE THE MARKET"},newsletter:{m1:"Find, compare, collect",m2:"Follow the Art Market weekly, straight to your inbox",m3:"Sign up for free"},registration:{m1:"All your art market and sales insights in one place",m2:"Create your account and track the market!",m3:"Sign up for free"},sources:{m2:"We support the free circulation of information. As such, you may republish excerpts from our article free of charge, provided that you add a clickable link to %a1%the article%/a% or to the website %a2%artprice.com%/a%, while respecting, where applicable, copyright laws. If your website has a paywall, we kindly ask that you make this information available in the freely accessible section of your site.",m3:"By %author%",m4:"Artprice News adheres to %a%an editorial charter based on five commitments%/a%"},copyrightshare:{m1:"Artprice Press Editorial",m2:"Share this article"},inlinepromotions:{newsletter:{m1:"Want the latest Art Market news delivered to you?",m2:"Receive weekly Market trends, analyzed by our editorial team.",m3:"Activate newsletter",m4:"Create a free account"},push:{m1:"Create your artist list",m2:"Opportunities don’t wait. Keep an eye on artists to stay ahead of the market.",m3:"Create a free account",m4:"Activate free alerts",m5:"Access your artists’ latest data."},favorites:{m2:"Track the visibility and performance of your artists.",m3:"Create your artist list"},marketplace:{m2:"Find your next favorite artwork on our Marketplace!",m3:"See all artworks for sale"},intuitiveartmarket:{m2:"What are connected collectors tracking?",m3:"Leverage the insights they rely on to sharpen your expertise.",m4:"Discover Intuitive ArtMarket®"}}},linktoarticle:{drawers:{noaccesdrawer:{m5:"Already a member?",m7:"All your art market and sales insights in one place",m8:"<strong>Create your free account</strong> and stay on top of the Art Market!",m9:"Sign up for free",m11:"Log in"},unvalidatedemaildrawer:{m1:"Go to your email inbox",m3:"Send a new email",m4:"Email address confirmed.",m5:"Go back to Artprice News",m6:"ast step: confirm your email address to activate your free Artprice account.",m7:"Didn’t receive the email?"}}},list:{m1:"Artprice News",m2:"Global Art Market Daily News",m3:"Our partners",m5:"Explore other articles",lists:{search:{m1:"Search results",m2:"No match found for your search",m3:"Search results for '%term%'",m4:"Clear search fields"}},searchinput:{m1:"Back",m2:"Search Artprice News",m3:"Search articles",m4:"Search articles for %artist%"}},author:{m1:"by"},common:{typeandpublicationdate:{m2:"Published on %dt%"},newstypes:{m1:"All the latest news"},header:{top:{m1:"Back to Artprice.com"}}},policy:{m1:"Accuracy and fact-checking",m2:"Each factual piece of information (auction result, exhibition date, attribution) is verified before publication using a primary source or documented market data, including the Artprice database, which has been an authoritative source on the global Art Market since 1987, with information provided by %nbauctioneers% partner auction houses.",m3:"Editorial independence from commercial activities",m4:"Artprice News is published by Artmarket.com, which also operates the Artprice database. The editorial team works independently from Artmarket.com’s commercial activities. Access to the news content is entirely free.",m5:"Acknowledged and visible corrections",m6:"When we make a mistake, we correct the article and date the correction. Any report submitted to the editorial team receives a response as soon as possible.",m7:"Real bylines, clear responsibilities",m8:"Each article is signed by the person who wrote it, with a link to their profile. If an assistance tool has contributed to the writing of an article, a member of the editorial team has verified every fact.",m9:"Proper image attribution and rights compliance",m10:"The pictures are systematically credited (artist, title). Artmarket.com has entered into numerous partnerships, notably with ADAGP (the collective management organization responsible for collecting and distributing authors’ rights worldwide).",m11:"The editorial team",m12:"Who writes Artprice News, and under what guidelines",m13:"Artprice News is an information publication dedicated to the Art Market, covering auctions, exhibitions, fairs, artists, and trends. The editorial team publishes <strong>three articles a day</strong> from Monday to Friday, in French and English. On this page, discover our editorial team, its writers, and their shared commitment to defending a simple conviction: qualified information on Art is essential in a global market that has become too vast, too fast-moving, and too opaque to be navigated through intuition alone.",m14:"The editorial team",m15:"%count% writers and art market specialists contribute to Artprice News. Each article is signed by the writer and reviewed by the editorial team.",m16:"The editorial policy, in %count% commitments",m17:"These commitments apply to everything we publish, in all languages. If an article fails to comply with them, %a%write to us%/a% and quote the number of the relevant issue.",m18:"Legal Information",m19:"Artprice News (publication details)",m20:"Publisher",m21:"Publicly traded company",m22:"Corporate headquarters",m23:"Publishing Director",m24:"Secretary General of Artmarket.com",m25:"Contact the editorial team",m26:"Hosted by",m27:"Report an error",m28:"Artprice News is the news service of Artmarket.com. It is funded, produced, and published by the editor. Access is free to readers, with no advertising and no third-party paid content.",m29:"At a time when artificial intelligence is accelerating the flow of information and blurring the line between documented fact and algorithmic reconstruction, Artprice News aims to provide contextualized information on art and the art market."}},newstype:{subtitle:{m0:"Global Art Market News",m1:"Global Art Market Daily News",m2:"Expert Insights on the Art Market",m3:"Know your way around the Art Market",m4:"Conversations with the people behind the Art Market",m5:"Artists on our radar",m6:"Global Art Market Reports"},m1:"News",m2:"ArtMarket® Insight",m3:"Practical Guides",m4:"Interviews",m5:"Artist Focus",m6:"Art Market Reports"}}}},nsSeparator:"¤",interpolation:{escapeValue:!1}})}},i={};function s(e){var t=i[e];if(void 0!==t)return t.exports;var r=i[e]={exports:{}};return a[e](r,r.exports,s),r.exports}s.m=a,s.d=(e,t,r)=>{var o=(t,r)=>{for(var o in t)s.o(t,o)&&!s.o(e,o)&&Object.defineProperty(e,o,{enumerable:!0,[r]:t[o]})};o(t,"get"),o(r,"value")},s.g=(()=>{if("object"==typeof globalThis)return globalThis;try{return this||Function("return this")()}catch(e){if("object"==typeof window)return window}})(),s.o=(e,t)=>Object.prototype.hasOwnProperty.call(e,t),e=[],s.O=(t,r,o,a)=>{if(r){a=a||0;for(var i=e.length;i>0&&e[i-1][2]>a;i--)e[i]=e[i-1];e[i]=[r,o,a];return}for(var n=1/0,i=0;i<e.length;i++){for(var r=e[i][0],o=e[i][1],a=e[i][2],m=!0,c=0;c<r.length;c++)(!1&a||n>=a)&&Object.keys(s.O).every(e=>s.O[e](r[c]))?r.splice(c--,1):(m=!1,a<n&&(n=a));if(m){e.splice(i--,1);var l=o();void 0!==l&&(t=l)}}return t},t={863:0},s.O.j=e=>0===t[e],r=(e,r)=>{var o,a,i=r[0],n=r[1],m=r[2],c=0;if(i.some(e=>0!==t[e])){for(o in n)s.o(n,o)&&(s.m[o]=n[o]);if(m)var l=m(s)}for(e&&e(r);c<i.length
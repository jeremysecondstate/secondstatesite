(()=>{"use strict";var e,t,r,o,a={48457(e,t,r){var o=r(36795);r.g.i18next||(r.g.i18next=o.Ay.createInstance()),r.g.i18next.init({lng:"en",fallbackLng:"en",resources:{en:{translation:{artprice:{client:{validatephysiccart:{m1:"users",m2:"user"},payment:{billdetail:{m12:"Qty"}},default:{m2:"Manage satellite accounts"}},lib:{tour:{tour4:{m63:"Viewing times"}},fsresultctrl:{m36:"Reproduction "},result:{indexresult:{m56:"%100_amount% invested in a work by %artist% in %year% would be worth an average of %final_amount% (%percentage%%) in %final_date%",m7:"Price index",m12:"Excluding prints",m30:"Growth rate"},indicatorresult:{m7:"Methodology"}},shop:{physicproductshortctrl:{m1:"Find out more"}},index:{method:{m1:"Econometric Methodology"}},navigbarartprice:{m_home:"Home",m_search:"Search"},myartprice:{artists:{m13:"MyArtprice"}},psresultctrl:{m6:"Hammer price",m18:"Lot #",m23:"Notes",m19:"Distinguishing marks",m7:"Estimate"},artitem:{m9:"Zoom in"},heading:{m1:"THE WORLD LEADER IN ART MARKET INFORMATION"},menu10:{m11:"Methodology"}},web:{pages:{classifieds:{decorative:{details:{m18:"Signature"}},create:{m31:"Not signed"}}}},fs:{fs:{m1:"Artists listed"}},artistsearch:{m21:"Best match first"},ps:{artitems:{m10:"Hammer price - highest to lowest",m11:"Title - from A to Z",m12:"Title - from Z to A",m13:"Auction date - in ascending order",m14:"Auction date - in descending order",m17:"Creation date - oldest first",m18:"Creation date - most recent first",m9:"Hammer price - lowest to highest"}},index:{legals:{m1:"Legals"}},storetype:{m1:"GALLERY",m2:"AUCTION HOUSE",m3:"ARTIST",m4:"Appraiser",m5:"PROFESSIONAL",m6:"INDIVIDUAL",m7:"DEALER",m8:"OTHER",m9:"Antique dealer",m10:"Collector",m11:"Art enthousiast"},mystore:{default:{m5:"On hold",m21:"Sold lots"},advert:{info:{m19:"Year"}}},Lib:{Navigbarartprice:{},PSResultCtrl:{}},wallet:{physicsale:{m14:"by"}},contact:{m103:"Contact us/FAQ"},phone:{m1:"Welcome, how can we help you?",m8:"Welcome %name%, how can we help you?"},landingpages:{services:{header:{m1:"Discover the real value of art"},legals:{m1:"Legal Notice",m2:"Non-biding offer valid until 22 June 2025 for any new Artprice account creation, limited to one use per person.",m3:"*Special limited-time offer : Discover Artprice Premium for just €9 for 9 days from your first use, with Basics One Day plan with Premium features and an 8-day extension. For comparison purposes, the standard monthly subscription plan with Premium features for the same or longer access period is priced at €53. To keep exploring with Intuitive ArtMarketⓇ, simply choose one of our Artprice Premium or Professional plans. Need help selecting the right option? Our customer service is here for you at +33 (0)472421706."},row1:{stamps:{m1:"million",m2:"clients and members trust Artprice",m3:"indices and sales results available",m4:"artists covered in 72 countries",m5:"Artificial Intelligence to find the true price of art"},m1:"Try Artprice Premium for €9 <strike>(€53)</strike>",m2:"Are you tempted by an artwork and want to know if it could grow in value?",m3:"Uncover its market potential and <strong>make the right choice (before others do)</strong>. <BR></BR> <p style='color: #840e46;'>Create your Artprice account before June 22nd*</p>",m4:"Try now for €9 <strike>(€53)</strike> ➡"},row2:{m1:"Navigate the Art Market with confidence",m2:"/day",m3:"Only until June 22nd",m4:"<strike>(€53)</strike>",m5:"<b>Find out in just a few clicks the potential of a work </b>(and where to buy it at the right price).",m6:"Try the largest Art Market database for <b>9 days at €9</b>*<br><b>- with no obligation -</b></br>",m7:"Get the offer ➡",m8:"Art is subjective. It is also a gamble"},row3:{stamps:{m1:"Follow the auctions",m2:"Track price changes",m3:"Evaluate sales volumes and the liquidity of artists",m4:"Find the auction houses where to buy"},m1:"Find artworks that have potential",m2:"You know how <strong>difficult (and risky) it is to evaluate a good investment</strong> based on other people's advice or thousands of auction results.",m3:"Enrich your interior and build your art collection<strong> with a clear vision</strong>. Artprice Premium is a simple tool that reveals what's hidden in price trends, <strong>so you can combine emotion and strategy.</strong>"},row4:{m1:"Savvy collectors understand",m2:"Do you love art, but hate the idea of ​​overpaying or missing out on an opportunity?",m3:"Our platform gives you direct access to crucial information to <b>buy and sell with confidence. </b>Discover artists' real-world ratings, comparable sales histories, and updated artwork prices—<b>all presented in a simple, visual way.</b>",m4:"Try Artprice Premium & find your next favorite ➔"},row5:{m1:"How does Artprice Premium work?",m2:"View each artist's market",m3:"Artprice's proprietary AI simplifies your valuations. It processes millions of auction results to provide you with precise benchmarks by artist.",m4:"Check the updated price of the artworks",m5:"AI analyzes past auction results to update a work's price. The AI ​​icon on auction results indicates which works benefit from this price data.",m6:"Create your account and get started now ➡",m7:"The Artprice team is here to guide you <a href='mailto:support@artprice.com'>by email</a> or by phone at +33 (0)472421706."},row6:{stamps:{m1:"Images and engravings since 1700",m2:"Auction Prices",m3:"Signatures and monograms"},testimonial:{m1:"Since its inception, Artprice has harnessed its genuine passion for art to help make the market transparent, accessible, and understandable for all. Their database, by far the most comprehensive in the world for fine art, their intelligent market analyses, and their commitment to capturing as many results as possible, including historical sales from the past, have changed the art market for the better.",m2:"Karl GREEN - Marketing Director",m3:"Koller International Auction"},m1:"Artprice.com, World Leader in Art Market Information"},row7:{faq:{m1:"What is Artprice Premium, and how does it work?",m2:"Artprice Premium provides access to Intuitive ArtMarket®: <b>market benchmarks by artist</b> to buy and sell with confidence on the Art Market.",m3:"Intuitive ArtMarket®'s proprietary AI draws on historical auction results to provide you with a simple and directly <b>actionable reading of price fluctuations</b>.",m4:"<b>Intuitive ArtMarket®</b> allows you to <b>find the current price of an artwork</b> and <b>identify emerging trends</b>, by graphically visualizing, for example, past fluctuations in value, the geographical distribution of sales and the evolution of unsold items.",m5:"Do I need to have knowledge of the Art Market to use Artprice?",m6:"<b>No.</b>",m7:"Artprice Premium is a simple and intuitive tool to help you navigate a complex and diverse Art Market.",m8:"With Intuitive ArtMarket® (included in our Premium & Professional plans) <b>you can graphically visualize</b> the artist's price trends, the number of lots sold by category, price level, or country. To make it even simpler, we've added a comparison with the performance of other artists and financial markets to help you visualize the financial outlook for your acquisition.",m9:"Intuitive ArtMarket® allows you to quickly <b>make informed buying and selling decisions, without having any in-depth knowledge</b> of the Art Market.",m10:"The <b>Artprice Indicator</b> allows you to consult the updated price of a work of art, even if it has not recently been auctioned.",m11:"How to find the updated price of a work?",m12:"Artprice Indicator analyzes a work's past auction results and reconstructs its trajectory to project its current price. Works that benefit from this indicator are identified by the AI ​​icon.",m13:"You can also <b>find the updated price of a work yourself with Artprice Premium & Professional subscriptions</b>. Start by searching for auction results for comparable works. You'll get a broad price range. Narrow and update this price range by taking into account the artist's market indicators over the past few years.",m14:"How do Artprice algorithms work?",m15:"Artprice's proprietary artificial intelligence (small language model) is based on massive, high-quality data. <b>It can detect similarities</b> between comparable works and repeat purchasing behavior. Our AI is based on the repeat sales method for undeniable traceability of a work's price over time and allows us to provide extremely reliable data on the evolution of a given work.",m16:"Artprice has <b>the most comprehensive art database in the world</b>, with %count-artists% artists and 210 million images and prints of artworks from 1700 to the present day.",m17:"How to check prices in different currencies and cryptocurrencies?",m18:"From an artist's auction results and upcoming sales, the 'Settings' button allows you to view hammer prices in <b>8 currencies</b> € $ £ ¥ ₪ (ILS) KR (SEK) CHF $CA and <b>2 cryptocurrencies</b> ₿ (BTC) + ♦ (ETH).",m19:"This way, you can make your buying or selling decisions in your currency.",m20:"How (and why) to compare the prices of one artist with that of another artist?",m21:"<b>An artist's rating</b> is an indicator calculated by Artprice, which measures an artist's value and reputation on the art market. It evolves over time based on market trends, the artist's career, and public interest in their work.",m22:"Comparing the ratings of several artists allows you to <b>confirm your intuitions or detect emerging trends</b> by comparing, for example, artists belonging to the same artistic movement.",m23:"Let's take the <b>example of Warhol and Basquiat, two artists whose paths intertwined</b>. While their rankings and annual sales figures are seemingly similar, comparing their prices reveals notable differences. Jean-Michel Basquiat's price has risen significantly since 2010, while Andy Warhol's has declined over the same period, indicating that Basquiat's works are significantly more sought-after on the market (and much rarer).<br> <br> From an artist's page, click on 'Find your way around the market' to access Intuitive ArtMarket®, then the artist's price, where you can make your comparisons."},m1:"Art is a journey, we are here to guide you",m2:"Here is how"},row8:{m1:"Find that gem before anyone else",m2:"Create your account before June 22nd and try for 9 days",m3:"- with no obligation -",m4:"Try now for €9 <strike>(€53)</strike> ➡",m5:"Create your account and schedule a demo call at +33 (0)472421706."}},services2:{header:{m1:"Discover the real value of art"},legals:{m1:"Legal Notice",m2:"Non-biding offer valid until 22 June 2025 for any new Artprice account creation, limited to one use per person.",m3:"Special limited-time offer : Discover Artprice Premium for just $9 for 9 days from your first use, with Basics One Day plan with Premium features and an 8-day extension. For comparison purposes, the standard monthly subscription plan with Premium features for the same or longer access period is priced at $53. To keep exploring with Intuitive ArtMarketⓇ, simply choose one of our Artprice Premium or Professional plans. Need help selecting the right option? Our customer service is here for you at +33 (0)472421706."},row1:{stamps:{m1:"million",m2:"clients and members trust Artprice",m3:"indices and sales results available",m4:"artists covered in 72 countries",m5:"Artificial Intelligence to find the true price of art"},m1:"Explore Art Market prices with AI for just €9 <strike>(€53)</strike>",m2:"Are you tempted by an artwork and want to know if it could grow in value?",m3:"Uncover its market potential with our algorithms and <strong> make the right choice</strong>. <BR></BR> <p style='color: #840e46;'>Create your Artprice account before June 22nd*</p>",m4:"Try now for €9 <strike>(€53)</strike> ➡"},row2:{m1:"Navigate the Art Market with confidence",m2:"/day",m3:"Only until June 22nd",m4:"<strike>(€53)</strike>",m5:"<strong>Find out in just a few clicks the value of an artwork </strong> (and where to buy it at the right price).",m6:"Try the largest database with Intuitive ArtMarketⓇ AI.  <BR> </BR>9 days for €9<strong> - no obligation</strong>.",m7:"Get the offer ➡",m8:"Art is subjective. It is also a gamble"},row3:{stamps:{m1:"Follow the auctions",m2:"Follow price changes",m3:"Assess sales volumes and the liquidity of artists",m4:"Find the auction houses where to buy"},m1:"Sharpen your artistic eye",m2:"Artprice's Intuitive ArtMarketⓇ AI sheds light on what's hidden behind the prices.",m3:"Intuitive ArtMarketⓇ is a simple tool that <strong>enables you to compare values of different artists</strong>, to narrow your selection."},row4:{m1:"Savvy collectors understand",m2:"Do you love art, but hate the idea of ​​overpaying or missing out on an opportunity?",m3:"Our platform gives you direct access to crucial information to <b>buy and sell with confidence</b>. Discover artists' real-world ratings, comparable sales histories, and updated artwork prices—<b>all presented in a simple, visual way.</b>",m4:"Find your next artwork ➔"},row5:{m1:"How does Intuitive ArtMarket® work?",m2:"View each artist's market",m3:"Artprice's proprietary AI simplifies your valuations. It processes millions of auction results to provide you with precise benchmarks by artist.",m4:"Check the updated price of the artworks",m5:"AI analyzes past auction results to update a work's price. The AI ​​icon on auction results indicates which works benefit from this price data.",m6:"Get started now ➡",m7:"The Artprice team is here to guide you <a href='mailto:support@artprice.com'>by email</a> or by phone at +33 (0)472421706."},row6:{stamps:{m1:"Images and engravings since 1700",m2:"Auction Prices",m3:"Signatures and monograms"},testimonial:{m1:"Since its inception, Artprice has harnessed its genuine passion for art to help make the market transparent, accessible, and understandable for all. Their database, by far the most comprehensive in the world for fine art, their intelligent market analyses, and their commitment to capturing as many results as possible, including historical sales from the past, have changed the art market for the better.",m2:"Karl GREEN - Marketing Director",m3:"Koller International Auction"},m1:"Artprice.com, World Leader in Art Market Information"},row7:{faq:{m1:"What is Intuitive ArtMarketⓇ, and how does it work?",m2:"Artprice Premium provides access to Intuitive ArtMarket®:  <b>market benchmarks by artist</b>, to buy and sell with confidence on the Art Market.",m3:"Intuitive ArtMarket®'s proprietary AI draws on historical auction results to provide you with a simple and directly <b>actionable reading of price fluctuations</b>.",m4:"<b>Intuitive ArtMarket®</b> allows you to <b>find the current price of an artwork</b> and <b>identify emerging trends</b>, by graphically visualizing, for example, past fluctuations in value, the geographical distribution of sales and the evolution of unsold items.",m5:"Do I need to have knowledge of the Art Market to use Artprice?",m6:"<b>No.</b>",m7:"Intuitive ArtMarket® is a simple and intuitive tool to help you navigate a complex and diverse Art Market. It can be found in our Premium & Professional plans.",m8:"With Intuitive ArtMarket®, <b>you can graphically visualize</b> the artist's price trends, the number of lots sold by category, price level, or country. To make it even simpler, we've added a comparison with the performance of other artists and financial markets to help you visualize the financial outlook for your acquisition.",m9:"Intuitive ArtMarket® allows you to quickly <b>make informed buying and selling decisions, without having any in-depth knowledge</b> of the Art Market.",m10:"The <b>Artprice Indicator</b> allows you to consult the updated price of a work of art, even if it has not recently been auctioned.",m11:"How to find the updated price of a work?",m12:"Artprice Indicator analyzes a work's past auction results and reconstructs its trajectory to project its current price. Works that benefit from this indicator are identified by the AI ​​icon.",m13:"You can also <b>find the updated price of a work yourself with Artprice Premium & Professional subscriptions</b>. Start by searching for auction results for comparable works. You'll get a broad price range. Narrow and update this price range by taking into account the artist's market indicators over the past few years.",m14:"How do Artprice algorithms work?",m15:"Artprice's proprietary artificial intelligence (small language model) is based on massive, high-quality data. <b>It can detect similarities</b> between comparable works and repeat purchasing behavior. Our AI is based on the repeat sales method for undeniable traceability of a work's price over time and allows us to provide extremely reliable data on the evolution of a given work.",m16:"Artprice has <b>the most comprehensive art database in the world</b>, with %count-artists% artists and 210 million images and prints of artworks from 1700 to the present day.",m17:"How to check prices in different currencies and cryptocurrencies?",m18:"From an artist's auction results and upcoming sales, the 'Settings' button allows you to view hammer prices in <b>8 currencies</b> € $ £ ¥ ₪ (ILS) KR (SEK) CHF $CA and <b>2 cryptocurrencies</b> ₿ (BTC) + ♦ (ETH).",m19:"This way, you can make your buying or selling decisions in your currency.",m20:"How (and why) to compare the prices of one artist with that of another artist?",m21:"<b>An artist's rating</b> is an indicator calculated by Artprice, which measures an artist's value and reputation on the art market. It evolves over time based on market trends, the artist's career, and public interest in their work.",m22:"Comparing the ratings of several artists allows you to <b>confirm your intuitions or detect emerging trends</b> by comparing, for example, artists belonging to the same artistic movement.",m23:"Let's take the <b>example of Warhol and Basquiat, two artists whose paths intertwined</b>. While their rankings and annual sales figures are seemingly similar, comparing their prices reveals notable differences. Jean-Michel Basquiat's price has risen significantly since 2010, while Andy Warhol's has declined over the same period, indicating that Basquiat's works are significantly more sought-after on the market (and much rarer).<br> <br> From an artist's page, click on 'Find your way around the market' to access Intuitive ArtMarket®, then the artist's price, where you can make your comparisons."},m1:"Art is a journey, we are here to guide you",m2:"Here is how"},row8:{m1:"Find that gem before anyone else",m2:"Create your account before June 22nd and try for 9 days",m3:"- with no obligation -",m4:"Take advantage of the offer ➡",m5:"Try Intuitive ArtMarketⓇ for €9 only <strike>(€53)</strike> and schedule a demo call at +33 (0)472421706."}},intuitiveartmarket:{row1:{m1:"How does Intuitive ArtMarket® work?",m2:"We know it's <strong>very difficult</strong> to determine the value of a work of art by consulting auction results alone. Too many objective and subjective parameters come into play.",m3:"Because providing you with reliable data to <strong>decipher the Art Market</strong> is our top priority, we have created <strong>simple and intuitive tools</strong> to allow you to navigate a complex and heterogeneous Art Market.",m4:"Subscribe to Artprice Premium",m5:"Access Intuitive ArtMarket"},row2:{testimonial:{m1:"Since its inception, Artprice has harnessed its genuine passion for art to help make the market transparent, accessible, and understandable for all. Their database, by far the most comprehensive in the world for fine art, their intelligent market analyses, and their commitment to capturing as many results as possible, including historical sales from the past, have changed the art market for the better.",m2:"Karl GREEN - Marketing Director",m3:"Koller International Auction"},m1:"View each artist's market",m2:"Artprice's proprietary AI simplifies your valuations. It processes millions of auction results to provide you with precise benchmarks by artist.",m3:"Check the updated price of the artworks",m4:"AI analyzes past auction results to update a work's price. The AI ​​icon indicates which works benefit from this price data.",m5:"Try with our free demo",m6:"and <u>download the 4-step guide</u> to find out all our tips!"},row3:{faq:{m1:"What is Intuitive ArtMarket®, and how does it work?",m2:"<b>Intuitive ArtMarket®</b> provides access to <b>market benchmarks by artist</b>, to buy and sell with confidence on the Art Market.",m3:"Intuitive ArtMarket®'s proprietary AI draws on historical auction results to provide you with a simple and directly <b>actionable reading of price fluctuations</b>.",m4:"<b>Intuitive ArtMarket®</b> allows you to <b>find the current price of an artwork</b> and <b>identify emerging trends</b>, by graphically visualizing, for example, past fluctuations in value, the geographical distribution of sales and the evolution of unsold items.",m5:"Do I need to have knowledge of the Art Market to use Artprice?",m6:"<b>No.</b>",m7:"Intuitive ArtMarket® is a <strong>simple and intuitive tool</strong> to help you navigate a complex and diverse Art Market. It can be found in our Premium & Professional plans.",m8:"With Intuitive ArtMarket®, <b>you can graphically visualize</b> the artist's price trends, the number of lots sold by category, price level, or country. To make it even simpler, we've added a comparison with the performance of other artists and financial markets to help you visualize the financial outlook for your acquisition.",m9:"Intuitive ArtMarket® allows you to quickly <b>make informed buying and selling decisions, without having any in-depth knowledge</b> of the Art Market.",m10:"The <b>Artprice Indicator</b> allows you to consult the updated price of a work of art, even if it has not recently been auctioned.",m11:"How to find the updated price of a work?",m12:"Artprice Indicator analyzes a work's past auction results and reconstructs its trajectory to project its current price. Works that benefit from this indicator are identified by the AI ​​icon.",m13:"You can also <b>find the updated price of a work yourself with Artprice Premium & Professional subscriptions</b>. Start by searching for auction results for comparable works. You'll get a broad price range. Narrow and update this price range by taking into account the artist's market indicators over the past few years.",m14:"How do Artprice algorithms work?",m15:"Artprice's proprietary artificial intelligence (small language model) is based on massive, high-quality data. <b>It can detect similarities</b> between comparable works and repeat purchasing behavior. Our AI is based on the repeat sales method for undeniable traceability of a work's price over time and allows us to provide extremely reliable data on the evolution of a given work.",m16:"Artprice has <b>the most comprehensive art database in the world</b>, with %count-artists% artists and 210 million images and prints of artworks from 1700 to the present day.",m17:"How to check prices in different currencies and cryptocurrencies?",m18:"From an artist's auction results and upcoming sales, the 'Settings' button allows you to view prices in <b>8 currencies</b> € $ £ ¥ ₪ (ILS) KR (SEK) CHF $CA and <b>2 cryptocurrencies</b> ₿ (BTC) + ♦ (ETH).",m19:"This way, you can make your buying or selling decisions in your currency.",m20:"How (and why) to compare the prices of one artist with that of another artist?",m21:"<b>An artist's rating</b> is an indicator calculated by Artprice, which measures an artist's value and reputation on the art market. It evolves over time based on market trends, the artist's career, and public interest in their work.",m22:"Comparing the ratings of several artists allows you to <b>confirm your intuitions or detect emerging trends</b> by comparing, for example, artists belonging to the same artistic movement.",m23:"Let's take the <b>example of Warhol and Basquiat, two artists whose paths intertwined</b>. While their rankings and annual sales figures are seemingly similar, <strong>comparing their prices reveals notable differences</strong>. Jean-Michel Basquiat's price has risen significantly since 2010, while Andy Warhol's has declined over the same period, indicating that Basquiat's works are significantly more sought-after on the market (and much rarer).<br> <br> From an artist's page, click on 'Find your way around the market' to access Intuitive ArtMarket®, then the artist's price, where you can make your comparisons."}},agi:{m1:"Econometric market analysis using the Artprice Global Index",m2:"The price indices developed by Artprice measure the quarterly evolution of the values ​​of Fine Art works since 1998. They are updated every quarter, after the recording and consolidation of the results of public auctions.",m3:"These overall indices are published in two currencies (USD and EUR) and broken down according to the main segmentations of the Art Market:",m4:"Five categories of works: Painting, sculpture, drawing, photography, and prints",m5:"Four major periods of creation: 19th century, Modern Art, Post-war Art and Contemporary Art",m6:"Three major geographical areas: United States, United Kingdom and France.",m7:"The calculation method for the Artprice Global Indexes is based on the repeat sales method, the theoretical foundations of which are presented in particular in the following reference publications:",m8:"Jianping Mei and Michael Moses 2002. 'Art as an Investment and the Underperformance of Masterpieces'. NYU Finance Working Paper No. 01-012.",m9:"William Goetzmann & Liang Peng, 2002. 'The Bias of the RSR Estimator and the Accuracy of Some Alternatives', Real Estate Economics, American Real Estate and Urban Economics Association, vol. 30(1), pages 13-39.",m10:"Download the Artprice Global Index"}},oneday:{header:{m1:"THE WORLD LEADER IN ART MARKET INFORMATION"},legals:{m1:"Legal Notice",m2:"Premium features included (Intuitive Art Market®, Artprice Indicators, and creation of custom lot lists) with any purchase of a one-day access (Basics 1-day plan) – No-commitment offer valid until 12/31/2026, reserved for new Artprice Members, limited to one use per person.",m3:"To continue the Intuitive ArtMarketⓇ journey, choose the Artprice Premium or Professional plan. Our customer service is available at +33 (0)472421706 to help you select the plan that best suits you."},row1:{stamps:{m1:"million",m2:"clients and members trust Artprice",m3:"indices and sales results available",m4:"artists covered in 72 countries",m5:"Artificial Intelligence to find the true price of art"},m1:"Admiring art is easy.<br> Choosing with precision<br> — must be learned.",m2:"You already follow artists whose work moves you, without really knowing their value?<br> <strong>This is where it all begins.</strong>",m3:"To go further and choose works that resonate with you and that you’ll be proud to own, get <strong>24 hours of unlimited access</strong> to the data that art professionals consult.",m4:"Get access for %price% ➡",m5:"unlimited access - 24 hours - no commitment"},row2:{m1:"There is no formal training to become a collector",m2:"/day",m3:"Unlimited access for 24 hours",m4:"<strike>(€53)</strike>",m5:"Artprice is the database that market professionals consult before buying and selling. For 24 hours, it can be yours too.",m6:"Discover in just a few clicks the value of a work (and where to buy it at the right price).",m7:"Get one-day access ➡",m8:"There is information that some people have access to — and others don’t",m9:"- with no obligation -"},row3:{stamps:{m1:"Enter the artist's name",m2:"Search comparable works",m3:"Price levels by medium, technique and by country",m4:"A unique archival collection enriched with art auctions since 1700"},m1:"Four steps, zero guesswork.",m2:"One-day access gives you full access to the Artprice database and its market benchmarks. Here’s how savvy buyers use it.",m3:"To make the most of your one-day access, here is a guide to assist you in your research."},row4:{m1:"The eye can be trained.<br> Market knowledge too.",m2:"A work chosen with full knowledge belongs to you twice — aesthetically and intellectually. It is this double certainty that transforms an interior into a collection, and a collection into something that truly reflects you.",m3:"Twenty years of valuations. Auction results. Comparable works.<br> Artprice puts it all at your fingertips.",m4:"Get your one-day access ➔"},row5:{m1:"How does Artprice Premium work?",m2:"View each artist’s market",m3:"Some people know the price history, but they don’t share it willingly. Artprice does — with all the auction results from auction houses around the world, since 1987.",m4:"Check the artworks' updated prices",m5:"AI analyzes past auction results to update a work's price. The AI ​​icon on auction results indicates which works benefit from this price data.",m6:"Start now for one-day ➡",m7:"Discover all the possibilities to <a href='https://www.artprice.com/estimate-with-artprice'>estimate your artworks with Artprice</a>."},row6:{stamps:{m1:"Images and engravings since 1700",m2:"Auction Prices",m3:"Signatures and monograms"},testimonial:{m1:"Since its inception, Artprice has harnessed its genuine passion for art to help make the market transparent, accessible, and understandable for all. Their database, by far the most comprehensive in the world for fine art, their intelligent market analyses, and their commitment to capturing as many results as possible, including historical sales from the past, have changed the art market for the better.",m2:"Karl GREEN - Marketing Director",m3:"Koller International Auction"},m1:"Artprice.com, World Leader in Art Market Information"},row7:{faq:{m1:"Estimating the value of an artwork / an artist",m2:"To get a valuation of your artworks and discover your artists' current prices:",m3:"<li><p style='text-align: justify;'>submit the description and photo of your artwork via an <span style='font-weight:bold'>Artpricing</span> for €&nbsp;72 (us$&nbsp;75&nbsp;/&nbsp;£&nbsp;69) per report (also available by pack) to get a <span style='font-weight:bold'>detailed estimate report</span> done by our group of specialists and art historians.<br/><a target='_blank' href='/estimate'>Submit your artwork here.</a></p></li>",m4:"<li><p style='text-align: justify;'>subscribe for a day, with monthly payments or for a year to get <span style='font-weight:bold'>unlimited access</span> to worldwide auction information!<br/><a target='_blank' href='/subscription'>See our subscriptions starting at €&nbsp;36 (us$&nbsp;36&nbsp;/&nbsp;£&nbsp;31) .</a></p></li>",m5:"Payment methods accepted",m6:"Artprice offers you several ways to pay for your order.",m7:"<li><span style='font-weight:bold;'>Secure online payment</span> for immediate activation:</li> <ul>   <li>by <b>bank card</b> : Visa, MasterCard, American Express, UnionPay;</li>   <li>with your <b>digital wallet</b>: Apple Pay, Google Pay, Wechat Pay, Alipay;</li>   <li>with a <b>PayPal</b> account (immediate payment or <b>in 4 interest-free payments</b> (subject to eligibility - <a href='https://www.paypal.com/us/digital-wallet/ways-to-pay/buy-now-pay-later'>find out more</a>) ;</li>   <li>NEW payment <b>in installments or later with Klarna</b> (subject to eligibility - <a href='https://www.klarna.com/us/legal/'>find out more</a>)</li> </li></ul>",m8:"<li><b>Payment by bank transfer</b> for activation upon receipt of your payment (bank charges at your expense). Print your order form to obtain our bank details. </li>",m9:"You can also <a href='https://www.artprice.com/contact?active=block8'>contact our Customer Service</a> and pay securely by telephone from Monday to Thursday from 9 a.m. to 8 p.m. (8 a.m. - 7 p.m. GMT/UTC) and Friday from 9 a.m. to 7 p.m.",m10:"The <b>Artprice Indicator</b> allows you to consult the updated price of a work of art, even if it has not recently been auctioned.",m11:"How to find the updated price of a work?",m12:"Artprice Indicator analyzes a work's past auction results and reconstructs its trajectory to project its current price. Works that benefit from this indicator are identified by the AI ​​icon.",m13:"You can also <b>find the updated price of a work yourself with Artprice Premium & Professional subscriptions</b>. Start by searching for auction results for comparable works. You'll get a broad price range. Narrow and update this price range by taking into account the artist's market indicators over the past few years.",m14:"How do Artprice algorithms work?",m15:"Artprice's proprietary artificial intelligence (small language model) is based on massive, high-quality data. <b>It can detect similarities</b> between comparable works and repeat purchasing behavior. Our AI is based on the repeat sales method for undeniable traceability of a work's price over time and allows us to provide extremely reliable data on the evolution of a given work.",m16:"Artprice has <b>the most comprehensive art database in the world</b>, with %count-artists% artists and 210 million images and prints of artworks from 1700 to the present day.",m17:"How to check prices in different currencies and cryptocurrencies?",m18:"From an artist's auction results and upcoming sales, the 'Settings' button allows you to view hammer prices in <b>8 currencies</b> € $ £ ¥ ₪ (ILS) KR (SEK) CHF $CA and <b>2 cryptocurrencies</b> ₿ (BTC) + ♦ (ETH).",m19:"This way, you can make your buying or selling decisions in your currency.",m20:"How (and why) to compare the prices of one artist with that of another artist?",m21:"<b>An artist's rating</b> is an indicator calculated by Artprice, which measures an artist's value and reputation on the art market. It evolves over time based on market trends, the artist's career, and public interest in their work.",m22:"Comparing the ratings of several artists allows you to <b>confirm your intuitions or detect emerging trends</b> by comparing, for example, artists belonging to the same artistic movement.",m23:"Let's take the <b>example of Warhol and Basquiat, two artists whose paths intertwined</b>. While their rankings and annual sales figures are seemingly similar, comparing their prices reveals notable differences. Jean-Michel Basquiat's price has risen significantly since 2010, while Andy Warhol's has declined over the same period, indicating that Basquiat's works are significantly more sought-after on the market (and much rarer).<br> <br> From an artist's page, click on 'Find your way around the market' to access Intuitive ArtMarket®, then the artist's price, where you can make your comparisons."},m1:"Art is subjective. It’s also a gamble.",m2:"We are here to guide you"},row8:{m1:"Admiring art is easy.",m2:"Choose with precision - start today",m3:"%price%. 24 hours. The complete Artprice database. <br> What some people know, Artprice shows you.",m4:"Get day access – %price% ➡",m5:"Unlimited access - 24 hours - no commitment"}}}},javascripts:{locales:{m4:"File format not authorized",m3:"Display more artists",m1:"Type in or select artist",m2:"Two characters minimum",m5:"You have reached the maximum number of images authorized per marketplace listing (5).",m6:"Wrong format",m7:"Required information",m8:"Incorrect email",m9:"The password and password confirmation do not match.",m10:"Facsimiles, mouldings from a cast, copies or other reproductions are not accepted on Artprice.com.",m11:"The only prints accepted on Artprice.com's marketplace are original prints with an identified and numbered edition, and hand-signed by the artist.",m12:"The artwork's size cannot be bigger than the overall framed size.",m13:"You must accept the terms",m14:"Text is too long",m15:"Starting price must be higher than €100.",m16:"Starting price must be higher than $100.",m17:"Starting price must be higher than £100.",m18:"Weight must be more than 0",m19:"You have a draft marketplace listing pending. Do you w